p1 <- ggplot(hologramm_statisch, aes(x = X, y = Y, fill = Intensitaet)) +
  geom_raster(interpolate = TRUE) +
  scale_fill_gradientn(colors = c("#05050A", "#0D1B2A", "#00FFCC", "#FFFFFF")) +
  theme_void() +
  labs(title = "// FIELD LOG: Static Baseline Matrix") +
